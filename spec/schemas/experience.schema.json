{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/governed-agent-runtime/experience.schema.json",
  "title": "Experience",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "experience_id", "world_delta_id", "started_at", "status", "authority_snapshot_digest", "actions", "verification", "provenance"],
  "properties": {
    "schema_version": {"const": "0.1.0-draft"},
    "experience_id": {"type": "string", "minLength": 1},
    "world_delta_id": {"type": "string", "minLength": 1},
    "started_at": {"type": "string", "format": "date-time"},
    "ended_at": {"type": ["string", "null"], "format": "date-time"},
    "status": {"enum": ["attempted", "tool_succeeded", "verified_complete", "partial", "failed", "unverifiable", "cancelled"]},
    "authority_snapshot_digest": {"type": "string", "minLength": 1},
    "plan_ref": {"type": "string"},
    "actions": {"type": "array", "items": {"type": "object"}},
    "expected_outcomes": {"type": "array", "items": {"type": "object"}},
    "observed_outcomes": {"type": "array", "items": {"type": "object"}},
    "verification": {"type": "object"},
    "corrections": {"type": "array", "items": {"type": "object"}},
    "lesson_candidates": {"type": "array", "items": {"type": "object"}},
    "privacy_classification": {"enum": ["public", "internal", "confidential", "restricted", "unknown"]},
    "retention_until": {"type": ["string", "null"], "format": "date-time"},
    "provenance": {"type": "object"}
  }
}
