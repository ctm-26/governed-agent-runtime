{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/governed-agent-runtime/skill.schema.json",
  "title": "Skill",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "skill_id", "name", "version", "lifecycle_status", "scope", "procedure", "required_capabilities", "evidence", "evaluation"],
  "properties": {
    "schema_version": {"const": "0.1.0-draft"},
    "skill_id": {"type": "string", "minLength": 1},
    "name": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "lifecycle_status": {"enum": ["candidate", "experimental", "trusted", "deprecated", "retired"]},
    "scope": {"type": "object"},
    "preconditions": {"type": "array", "items": {"type": "string"}},
    "procedure": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "required_capabilities": {"type": "array", "items": {"type": "string"}},
    "required_authority": {"type": "array", "maxItems": 0},
    "outcome_contract": {"type": "object"},
    "evidence": {"type": "array", "items": {"type": "string"}},
    "evaluation": {"type": "object"},
    "known_failures": {"type": "array", "items": {"type": "string"}},
    "rollback": {"type": "object"},
    "provenance": {"type": "object"}
  }
}
